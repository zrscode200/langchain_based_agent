{
  "name": "lc-agent-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "tsx server/main.ts --dev",
    "build": "tsc --noEmit && vite build",
    "build:launcher": "tsc --noEmit && node build-launcher.mjs",
    "start": "tsx server/main.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "lucide-react": "1.43.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
